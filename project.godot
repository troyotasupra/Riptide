; Engine configuration file.
; Hand-authored; Godot may reformat it when the editor saves.

config_version=5

[application]

config/name="Riptide"
config/description="Co-op survival on a hostile modern sea."
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://autoload/controls.gd"
Ocean="*res://autoload/ocean_clock.gd"
GameState="*res://autoload/game_state.gd"
Net="*res://autoload/net.gd"
SaveGame="*res://autoload/save_game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
